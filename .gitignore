# ---------------------------------------------------------------------------
# AlignLab .gitignore
#
# Rule: the repository holds SOURCE, CONFIG, TESTS and DOCUMENTATION only.
# Model weights, checkpoints, caches, credentials and run outputs never enter
# Git. They live under environment-variable-rooted paths (see src/alignlab/
# paths.py) precisely so that they can be kept out of version control and can
# differ between the local machine and the department server.
# ---------------------------------------------------------------------------

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# --- Virtual environments ---
.venv/
venv/
env/.venv/
ENV/

# --- Test / coverage / type-check caches ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.hypothesis/

# --- Hydra ---
# Hydra writes a .hydra/ directory of resolved configs into every run dir.
# The run dirs themselves are ignored below; this covers stray top-level ones.
.hydra/
multirun/

# --- AlignLab run artifacts (env-var rooted; these are the LOCAL defaults) ---
outputs/
checkpoints/
runs/
artifacts/

# --- Experiment tracking ---
wandb/
.wandb/

# --- Model weights & tokenizers (never in Git) ---
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.gguf
*.onnx

# --- Hugging Face / dataset caches ---
.cache/
hf_cache/
huggingface/
datasets_cache/

# --- Credentials / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
netrc
.netrc

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Jupyter ---
.ipynb_checkpoints/

# --- Logs ---
*.log
logs/
